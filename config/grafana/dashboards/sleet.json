{
  "title": "Sleet",
  "uid": "sleet-broker",
  "tags": [],
  "timezone": "browser",
  "schemaVersion": 30,
  "refresh": "5s",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Active Connections",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sleet_connections_active",
          "legendFormat": "Connections",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "noValue": "0"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Active Subscriptions",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (topic) (sleet_subscriptions_active)",
          "legendFormat": "{{topic}}",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "noValue": "0"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Total Message Throughput (Rate)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "rate(sleet_messages_published_total[1m])",
          "legendFormat": "Published ({{topic}})",
          "format": "time_series",
          "instant": false
        },
        {
          "expr": "rate(sleet_messages_delivered_total[1m])",
          "legendFormat": "Delivered (Global)",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "noValue": "0"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Bandwidth",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Network Traffic",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "rate(sleet_websocket_bytes_received_total[1m])",
          "legendFormat": "Received",
          "format": "time_series",
          "instant": false
        },
        {
          "expr": "rate(sleet_websocket_bytes_sent_total[1m])",
          "legendFormat": "Sent",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "noValue": "0"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Message Size (P95 & Avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sleet_message_size_bytes_bucket[5m])) by (le))",
          "legendFormat": "P95 Size",
          "format": "time_series",
          "instant": false
        },
        {
          "expr": "sum(rate(sleet_message_size_bytes_sum[5m])) / sum(rate(sleet_message_size_bytes_count[5m]))",
          "legendFormat": "Avg Size",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "noValue": "0"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      }
    },
    {
      "type": "row",
      "title": "Latency & Queues",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "timeseries",
      "title": "Processing Latency (P95 & Avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sleet_message_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Overall Processing",
          "format": "time_series",
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(sleet_validation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Validation Only",
          "format": "time_series",
          "instant": false
        },
        {
          "expr": "sum(rate(sleet_message_processing_duration_seconds_sum[5m])) / sum(rate(sleet_message_processing_duration_seconds_count[5m]))",
          "legendFormat": "Avg Processing",
          "format": "time_series",
          "instant": false
        },
        {
          "expr": "sum(rate(sleet_validation_duration_seconds_sum[5m])) / sum(rate(sleet_validation_duration_seconds_count[5m]))",
          "legendFormat": "Avg Validation",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "noValue": "0"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "Client Queue Depth (P95)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sleet_client_queue_depth_bucket[1m])) by (le))",
          "legendFormat": "P95 Depth",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "noValue": "0"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "Client Queue Depth (P99 & Avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(sleet_client_queue_depth_bucket[1m])) by (le))",
          "legendFormat": "P99 Depth",
          "format": "time_series",
          "instant": false
        },
        {
          "expr": "sum(rate(sleet_client_queue_depth_sum[1m])) / sum(rate(sleet_client_queue_depth_count[1m]))",
          "legendFormat": "Avg Depth",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "noValue": "0"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      }
    },
    {
      "type": "row",
      "title": "Errors & Drops",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      }
    },
    {
      "type": "timeseries",
