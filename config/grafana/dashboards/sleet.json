      },
      "targets": [
        {
          "expr": "rate(sleet_connections_failed_total[1m])",
          "legendFormat": "Failed ({{error}})",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "noValue": "0"
        }
      },
      "gridPos": {
        "h": 8,
