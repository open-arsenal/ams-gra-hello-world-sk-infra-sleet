# === Rust ===
# Generated by Cargo
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# === Python ===
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === Project/local tooling ===
.idea/
*.code-workspace

# === Build / runtime artifacts ===
dist/
build/
.cache/
tmp/
*.log
THIRD_PARTY_LICENSES.html
sbom-*.cdx.json
docs/html/

# UCI schema files (fetched from upstream, not committed)
/spec/

